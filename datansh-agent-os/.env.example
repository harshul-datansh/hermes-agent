# Datansh Agent OS local runtime configuration.
# Copy this file to .env and fill values there. Do not commit real keys.
# Hermes secrets should live in ~/.hermes/.env or your local environment.

# Required for live OpenRouter calls. Leave blank for offline POC demo mode.
OPENROUTER_API_KEY=<your-openrouter-key>

# Local-only guard/key for future local API server experiments.
API_SERVER_KEY=change-me-local-only

# Free-only model configuration. Keep openrouter/free or explicit :free IDs.
# DATANSH_DEFAULT_MODEL is only the fallback for any role not listed in
# scripts/run_demo.py ROLE_MODELS. Each of the 7 roles has its own dedicated
# primary/fallback model pinned there -- see docs/model-assignments.md for the
# assignment table and rationale.
DATANSH_LLM_PROVIDER=openrouter
DATANSH_DEFAULT_MODEL=openrouter/free

# Local paths and ports.
DATANSH_EVENTS_PATH=monitor/events.jsonl
DATANSH_DEMO_INPUT=demo/input.md
DATANSH_RUNS_DIR=demo/runs
HERMES_HOME=
HERMES_DASHBOARD_HOST=127.0.0.1
HERMES_DASHBOARD_PORT=9119
DATANSH_MONITOR_HOST=127.0.0.1
DATANSH_MONITOR_PORT=8501

# OpenRouter app attribution headers for direct API tests.
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=Datansh Agent OS

# Set this after you create the Datansh GitHub fork, then run attach_fork_remote.
# Example: https://github.com/datansh/hermes-agent.git
DATANSH_HERMES_FORK_URL=
